// ============================================
// Prisma Schema for Hypercord Discord Bot
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Core Models
// ============================================

/// Guild (Discord Server) configuration
model Guild {
  id        String   @id // Discord guild ID
  name      String
  ownerId   String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  isActive  Boolean  @default(true)
  config    Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members       GuildMember[]
  warnings      Warning[]
  bans          Ban[]
  kicks         Kick[]
  notes         Note[]
  reminders     Reminder[]
  auditLogs     AuditLog[]
  commandLogs   CommandLog[]
  customCommands CustomCommand[]

  @@index([ownerId])
  @@index([isActive])
  @@map("guilds")
}

/// User data (cross-guild)
model User {
  id        String   @id // Discord user ID
  username  String
  globalName String?
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guildMemberships GuildMember[]
  warnings         Warning[]
  bans             Ban[]
  kicks            Kick[]
  notes            Note[]
  reminders        Reminder[]

  @@index([username])
  @@map("users")
}

/// Guild membership (user in a specific guild)
model GuildMember {
  id       String   @id @default(cuid())
  userId   String
  guildId  String
  nickname String?
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  isActive Boolean  @default(true)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@index([isActive])
  @@map("guild_members")
}

// ============================================
// Moderation Models
// ============================================

/// Warning issued to a user
model Warning {
  id         String   @id @default(cuid())
  userId     String
  guildId    String
  moderatorId String
  reason     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  isActive   Boolean  @default(true)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([moderatorId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("warnings")
}

/// Ban record
model Ban {
  id          String    @id @default(cuid())
  userId      String
  guildId     String
  moderatorId String
  reason      String
  bannedAt    DateTime  @default(now())
  expiresAt   DateTime? // Null = permanent ban
  unbannedAt  DateTime?
  isActive    Boolean   @default(true)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([moderatorId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("bans")
}

/// Kick record
model Kick {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  moderatorId String
  reason      String
  kickedAt    DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([moderatorId])
  @@map("kicks")
}

/// Moderator notes on users
model Note {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  moderatorId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([moderatorId])
  @@map("notes")
}

// ============================================
// Feature Models
// ============================================

/// Scheduled reminders
model Reminder {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  channelId   String
  content     String
  scheduledFor DateTime
  createdAt   DateTime @default(now())
  completedAt DateTime?
  isCompleted Boolean  @default(false)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([scheduledFor])
  @@index([isCompleted])
  @@map("reminders")
}

/// Custom commands per guild
model CustomCommand {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  response    String
  creatorId   String
  usageCount  Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
  @@index([isEnabled])
  @@map("custom_commands")
}

// ============================================
// Logging Models
// ============================================

/// Command execution logs
model CommandLog {
  id        String   @id @default(cuid())
  command   String
  userId    String
  guildId   String?
  channelId String?
  success   Boolean  @default(true)
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([command])
  @@index([userId])
  @@index([guildId])
  @@index([createdAt])
  @@map("command_logs")
}

/// Audit log for moderation actions
model AuditLog {
  id          String   @id @default(cuid())
  guildId     String
  moderatorId String
  action      String   // BAN, KICK, WARN, etc.
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([moderatorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Analytics Models
// ============================================

/// Daily statistics
model DailyStats {
  id               String   @id @default(cuid())
  date             DateTime @unique @db.Date
  commandsExecuted Int      @default(0)
  commandsFailed   Int      @default(0)
  guildsActive     Int      @default(0)
  usersActive      Int      @default(0)
  messagesProcessed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@map("daily_stats")
}
