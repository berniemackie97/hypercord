# For running the bot directly on the host. Use docker-compose.dev.yml for local services.
BOT_TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id
# Enable only after MESSAGE_CONTENT privileged access is enabled in Discord Developer Portal.
# Required for content-dependent XP, spam scanning, and message history caching.
MESSAGE_CONTENT_ENABLED=false
GUILD_ID=

DATABASE_URL=postgresql://hypercord:replace_with_unique_postgres_password@localhost:5432/hypercord
REDIS_URL=redis://:replace_with_unique_redis_password@localhost:6379

ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
