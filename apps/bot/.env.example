# Discord
BOT_TOKEN=
CLIENT_ID=        # application id
GUILD_ID=         # dev guild id (optional; speeds up command registration)

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hypercord?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI API Keys (optional - only needed if using that provider)
# Gemini is FREE and recommended for default usage
GEMINI_API_KEY=           # Get from https://ai.google.dev
# OPENAI_API_KEY=         # Get from https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=      # Get from https://console.anthropic.com/settings/keys
# GROK_API_KEY=           # Get from https://console.x.ai
