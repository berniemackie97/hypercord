# Copy to .env for Docker Compose, then replace every placeholder with your own secret.
# Keep this file out of source control. Use a secrets manager for production deployments.
BOT_TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id
GUILD_ID=

POSTGRES_PASSWORD=replace_with_unique_postgres_password
REDIS_PASSWORD=replace_with_unique_redis_password

# These URLs are used inside the Compose network. Their credentials must match the passwords above.
# URL-encode reserved characters when embedding passwords in a connection string.
DATABASE_URL=postgresql://hypercord:replace_with_unique_postgres_password@postgres:5432/hypercord
REDIS_URL=redis://:replace_with_unique_redis_password@redis:6379

# Enable only after MESSAGE_CONTENT privileged access is enabled in Discord Developer Portal.
# Required for content-dependent XP, spam scanning, and message history caching.
MESSAGE_CONTENT_ENABLED=false
NODE_ENV=production
LOG_LEVEL=info
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=

# Optional providers; supply credentials only for providers you enable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
