# ============================================
# Hypercord Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Discord Bot Configuration
BOT_TOKEN=your_discord_bot_token_here
APPLICATION_ID=your_application_id_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://hypercord:dev_password_change_in_production@localhost:5432/hypercord?schema=public&connection_limit=5&pool_timeout=20

# Redis (Cache & Queue)
REDIS_URL=redis://:dev_redis_password@localhost:6379

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Optional: Admin Allowlists (comma-separated Discord IDs)
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=

# Production overrides (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=info
# DATABASE_URL=postgresql://user:password@prod-db:5432/hypercord?schema=public&connection_limit=10&pool_timeout=30
# REDIS_URL=redis://:password@prod-redis:6379
